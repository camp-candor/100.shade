{
  "compilerOptions": {
    //  "declaration": true,
    "module": "Node16",
    "target": "es2017",
    "incremental": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": false,
    "moduleResolution": "Node16",
    "types": ["node"],
    "resolveJsonModule": false,
    "sourceMap": true,
    "skipLibCheck": false,
    "outDir": "dist",
    "strict": false,
    "strictNullChecks": false
  }
}
